# ============================================================
# UrbanSenseAI Environment Configuration
# ============================================================

# Physical Edge Bus Configuration
BUS_ID=BUS-001
BUS_NAME=Physical Prototype Bus
REGISTRATION_NUMBER=TN-01-AL-2026
ROUTE_NAME=Route 21G (Broadway - Tambaram)

# Camera Stream Configuration
# Options:
# 1. IP Camera Stream: http://<PHONE_IP>:8080/video
# 2. Local Webcam Index: 0
# 3. Test Video File: data/sample_videos/test.mp4
CAMERA_SOURCE=http://YOUR_PHONE_IP:8080/video
CAMERA_RECONNECT_DELAY=3.0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# AI Model Configuration
YOLO_MODEL_PATH=yolo11n.pt
URBAN_MODEL_PATH=models/urban_model.pt
DETECTION_CONFIDENCE=0.35
IOU_THRESHOLD=0.45
CUDA_DEVICE=0

# GPS Configuration
# Options: demo, phone, hardware
GPS_MODE=demo
DEFAULT_LATITUDE=13.0827
DEFAULT_LONGITUDE=80.2707

# Backend & Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbansense
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=urbansense

# API & WebSocket Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://localhost:8000/api
WS_URL=ws://localhost:8000/ws/live

# Media Storage Directory
MEDIA_DIR=media

# Simulation & Demo Settings
DEMO_MODE=true
SIMULATED_BUSES_COUNT=4
